// The site and its aggregate counters. The app itself sends no analytics.
{
  "name": "agentmuster",
  "main": "worker.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/privacy", "/site.js", "/api/*", "/changelog*", "/guides/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/client.js"], "fallthrough": true }],
  "d1_databases": [{ "binding": "METRICS", "database_name": "muster-gtm", "database_id": "4d17e6d9-ce8a-42e2-869c-934dddcb4021" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false },
  "logpush": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agentmuster.app", "custom_domain": true }]
}
